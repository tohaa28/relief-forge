%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: -10 20 278 164
%%HiResBoundingBox: -10.25 20.5 277.75 164.5
%%LanguageLevel: 3
%%EndComments
/box { newpath 0 0 moveto 20 0 lineto 20 20 lineto 0 20 lineto closepath } bind def
gsave -10.25 20.5 translate
1 0 0 setrgbcolor newpath 10 10 moveto 30 90 70 90 90 10 curveto closepath fill
0 0 1 setrgbcolor 2 setlinewidth newpath 110 10 moveto 130 80 170 80 190 10 curveto stroke
gsave 210 50 translate 30 rotate .5 1.5 scale 0 1 0 setrgbcolor box fill grestore
gsave newpath 100 80 160 50 rectclip 1 0 1 setrgbcolor newpath 100 60 moveto 250 140 lineto 100 140 lineto closepath fill grestore
/Helvetica findfont 18 scalefont setfont 0 setgray 10 110 moveto (EPS Test) show
grestore showpage
%%EOF
